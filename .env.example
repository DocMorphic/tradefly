# Local Python backend only. Use PAPER credentials; never commit .env.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Vercel server settings (copy these to .env.local for local Next.js development).
# Create a free Turso libSQL database. No Alpaca keys belong in Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate two DIFFERENT random keys, at least 32 characters each.
TRADEFLY_OWNER_KEY=
TRADEFLY_BRIDGE_TOKEN=

# Local .env.bridge only: set after deploying to Vercel; omit to keep Sites.
TRADEFLY_SITE_URL=
# Only needed if Vercel Deployment Protection blocks worker requests.
TRADEFLY_VERCEL_BYPASS_TOKEN=
# Existing Sites deployments continue to use this local bypass token.
TRADEFLY_SITES_TOKEN=
