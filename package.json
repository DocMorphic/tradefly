{
  "name": "tradefly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "backend": "uv run python -m tradefly.runner --load-brain",
    "test:backend": "uv run pytest -q",
    "swarm:terminal": "node scripts/swarm-terminal.mjs",
    "dev:vercel": "next dev",
    "build:vercel": "next build",
    "start:vercel": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-vercel.mjs",
    "setup:vercel": "node scripts/configure-vercel.mjs",
    "test:vercel": "node scripts/test-vercel.mjs",
    "crypto:paper": "uv run python -m tradefly.crypto_runner",
    "crypto:anchor": "node --env-file-if-exists=.env.crypto --experimental-strip-types scripts/crypto-anchor.mjs",
    "test:crypto-chain": "node --experimental-strip-types scripts/test-crypto-chain.mjs",
    "crypto:demo": "node --experimental-strip-types scripts/crypto-demo.mjs",
    "crypto:setup": "node scripts/setup-crypto.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@libsql/client": "^0.18.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jose": "^6.2.12",
    "lucide-react": "1.31.0",
    "next": "^16.3.5",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.57.13",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@foundry-rs/anvil": "1.7.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "solc": "0.8.38",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "imports": {
    "#tradefly-runtime": "./lib/server/runtime-vercel.ts"
  }
}
